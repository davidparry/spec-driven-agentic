# Copy produced at the repo root by `dist build` (extra-artifacts)
/spec-harness-uninstaller.sh

# GitHub Pages build output
_site/

# Spec harness home: generated state stays untracked; configuration is shared.
.spec/*
!.spec/config.toml

# macOS Finder metadata
.DS_Store
# Claude Code: keep shared project settings; ignore machine-local files
.claude/*
!.claude/settings.json

/harness/.bdd-log/
/harness/.cargo
/harness/.cargo/
/harness/.spec-history
